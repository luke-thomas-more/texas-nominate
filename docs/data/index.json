 ],
 "beta": 12.149849727779976,
 "axes": {
  "x": {
   "name": "liberal to conservative",
   "short": "Left–right",
   "neg": "More liberal",
   "pos": "More conservative",
   "desc": "The main line along which Texas votes split. What it stands for depends on the era; see the guide for each era."
  },
  "y": {
   "name": "the second divide",
   "short": "Second",
   "neg": "Down",
   "pos": "Up",
   "desc": "The second line along which votes split, after the main one. Its meaning changes more from era to era than the main divide's."
  },
  "dims": {
   "note": "The second dimension earns its place: it cuts the errors left by one dimension by about a ninth. A third cuts them by a little less again, but it has no clear, stable meaning across eras, so the maps show the first two."
  },
  "eras": [
   {
    "from": 1,
    "to": 13,
    "label": "1846–1873: statehood, Civil War and Reconstruction",
    "x": {
     "desc": "Before the Civil War there was no lasting two-party divide in Austin, and the axis is hard to name: the fire-eater Louis T. Wigfall sits well to the left and the Unionist James W. Throckmorton well to the right, but with so few members' parties on record, two careers can't say what the sides stood for. Most members before Reconstruction have no party on record. In the Reconstruction legislatures of 1870–73, House Republicans sit to the left of Democrats but Senate Republicans to the right: few members linked the two chambers in these years, so compare members within a chamber. In both, Republicans sit below Democrats (see the second axis).",
     "name": "the main divide",
     "neg": "Left",
     "pos": "Right"
    },
    "y": {
     "name": "party and region",
     "neg": "Republicans; border and German counties",
     "pos": "Democrats; rural East and North Texas",
     "desc": "In the Reconstruction legislatures of 1870–73, Republicans, Radicals included, sit below Democrats in both chambers. By home county, the border (Webb, Starr, Cameron, El Paso), the German Hill Country (Comal), Austin, Houston and San Antonio sit low, and rural East and North Texas high. In the House most votes still split left to right; in the Senate, up-and-down splits are about as common."
    }
   },
   {
    "from": 14,
    "to": 26,
    "label": "1874–1900: after Reconstruction",
    "x": {
     "desc": "Democrats held most seats, and the main divide ran through them. On regulating corporations and trusts and on protecting labor unions, reformers sit to the left and their opponents to the right. The parties that challenged the Democrats land on different sides by decade: Republicans and Greenbackers of the 1870s and 1880s sit to the left, while the Populists of the 1890s and the Republicans who worked with them sit to the right. In this era the axis partly tracks who opposed the Democratic majority at the time, not one fixed ideology.",
     "name": "reform to conservative",
     "neg": "Reform",
     "pos": "Conservative"
    },
    "y": {
     "name": "countryside to cities and border",
     "neg": "Cities, border, German counties",
     "pos": "Rural Anglo counties",
     "desc": "Members from the rural Anglo counties, especially in North Texas, sit at the top. At the bottom are Galveston, Houston and San Antonio, the border counties such as Webb and Starr, and the German counties (Blanco, Fayette, DeWitt). About a third of contested votes split up and down along this line, as many as split left to right."
    }
   },
   {
    "from": 27,
    "to": 41,
    "label": "1901–1930: prohibition and the Progressive Era",
    "x": {
     "desc": "Progressives sit to the left, conservatives to the right. Prohibition, the era's defining fight, runs mostly up and down the map instead: on the 1911 and 1913 liquor votes the drys sit at the top and the wets at the bottom, with the drys also to the left, a little in the House and more in the Senate.",
     "name": "progressive to conservative",
     "neg": "More progressive",
     "pos": "More conservative"
    },
    "y": {
     "name": "dry countryside to wet cities",
     "neg": "Wet: cities, border, German counties",
     "pos": "Dry: rural Anglo counties",
     "desc": "The top is the dry countryside: rural Anglo counties of East, North and West Texas. The bottom is the wet Texas of San Antonio, Houston, Galveston and Beaumont, the border, and the German and Czech counties of Central Texas. With nearly every member a Democrat, this regional and cultural split decided more contested votes than the left–right one."
    }
   },
   {
    "from": 42,
    "to": 56,
    "label": "1931–1960: New Deal liberals and conservative Democrats",
    "x": {
     "desc": "Liberal Democrats such as Maury Maverick Jr. and Henry B. González sit to the left, and conservative Democrats such as Dorsey Hardeman, Wardlow Lane and Coke Stevenson to the right."
    },
    "y": {
     "name": "countryside to cities and border",
     "neg": "Cities, border",
     "pos": "Rural Anglo counties",
     "desc": "As before 1930, rural Anglo counties of East and North Texas sit at the top, and the big cities (Houston, Dallas, Fort Worth, San Antonio) and the Rio Grande Valley at the bottom. In these one-party decades this was still the most common way votes split."
    }
   },
   {
    "from": 57,
    "to": 62,
    "label": "1961–1972: liberals and conservatives",
    "x": {
     "desc": "Liberals such as Bob Eckhardt, Barbara Jordan, Oscar Mauzy and Sissy Farenthold sit to the left, conservative Democrats to the right."
    },
    "y": {
     "name": "countryside to cities",
     "neg": "Cities",
     "pos": "Rural and small-city Texas",
     "desc": "Rural and small-city members sit at the top, and the Dallas delegation at the bottom, with Fort Worth, Laredo and Duval County also below the middle. In the House more contested votes split up and down than left and right, though most fall in between."
    }
   },
   {
    "from": 63,
    "to": 67,
    "label": "1973–1982: the first Republicans",
    "x": {
     "desc": "Liberals such as Mickey Leland, Gonzalo Barrientos, Wilhelmina Delco and Eddie Bernice Johnson sit to the left, conservative Democrats to the right, and the growing Republican caucus joins them on the right. In the House most contested votes now split left and right."
    },
    "y": {
     "name": "Republicans and big cities to rural Democrats",
     "neg": "Rural Democrats",
     "pos": "Republicans, Houston and Dallas",
     "desc": "In the House, the Republicans and the Houston and Dallas delegations, Democrats included, sit at the top, and rural Democrats at the bottom. It's the first sign of the 1980s split between suburban Republicans and the rest of Texas."
    }
   },
   {
    "from": 68,
    "to": 73,
    "label": "1983–1994: the Republicans' rise",
    "x": {
     "desc": "Liberal Democrats to the left, Republicans to the right, with conservative rural Democrats in between."
    },
    "y": {
     "name": "suburbs and cities to rural Democrats",
     "neg": "Rural Democrats",
     "pos": "Suburbs and cities",
     "desc": "As Republicans won the suburbs, the top of this axis came to hold them (Collin, Denton and Midland counties, suburban Dallas and Houston), with the cities' Democrats above the middle and rural Democrats at the bottom. Party now shows up on both axes."
    }
   },
   {
    "from": 74,
    "to": 89,
    "label": "1995–2025: the two-party era",
    "x": {
     "desc": "Almost entirely Democrats against Republicans. In the 1990s, when many rural and South Texas Democrats voted conservatively, the parties overlapped much more."
    },
    "y": {
     "name": "establishment to anti-establishment",
     "short": "Establishment",
     "neg": "Anti-establishment",
     "pos": "Establishment",
     "desc": "Within both parties, this separates members who vote with their chamber's leadership from those who buck it. Among House Republicans, the top is each era's Speaker's team: Talmadge Heflin and Fred Hill under Craddick, Stan Lambert more recently. The bottom is the rebels: Jonathan Stickland, Brian Harrison and Andy Hopper. Among Democrats, mavericks like Terry Canales sit lowest. In the Senate the axis separates institutionalists such as Robert Nichols and Charles Schwertner from members such as Mayes Middleton and Sarah Eckhardt."
    }
   }
  ]
 },
